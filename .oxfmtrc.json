{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "singleQuote": false,
  "semi": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "sortTailwindcss": { "stylesheet": "./app/assets/main.css" },
  "ignorePatterns": [
    "pnpm-lock.yaml",
    ".wrangler/**",
    ".playwright-mcp/**",
    ".playwright-cli/**"
  ]
}
