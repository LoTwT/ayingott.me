{
  "name": "ayingott-me",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev -o",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "simple-git-hooks",
    "up": "taze latest -I -f",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings . && oxfmt --check .",
    "lint:fix": "oxlint --fix . && oxfmt .",
    "nuxt": "nuxt",
    "typecheck": "nuxt typecheck",
    "verify:blog-date-timezone": "node scripts/verify-blog-date-timezone.mjs"
  },
  "dependencies": {
    "@ayingott/theme": "0.0.2",
    "@nuxt/content": "^3.15.2",
    "vue": "^3.5.41",
    "vue-router": "5.0.6"
  },
  "devDependencies": {
    "@nuxtjs/color-mode": "^4.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@vue/language-core": "^3.3.9",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "lint-staged": "^16.4.0",
    "nuxt": "4.4.5",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "4.3.3",
    "taze": "^19.17.2",
    "typescript": "^6.0.3",
    "vite": "7.3.6",
    "vue-tsc": "^3.3.9"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ],
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "simple-git-hooks"
    ],
    "overrides": {
      "@nuxt/cli": "3.35.2"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*": [
      "oxlint --fix --deny-warnings --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  }
}
